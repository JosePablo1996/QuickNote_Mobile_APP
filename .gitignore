# ============================================
# SEGURIDAD Y CLAVES DE FIRMA (NO SUBIR A GITHUB)
# ============================================

# Archivos del keystore y claves privadas
*.jks
*.keystore
*.key
*.p12
*.pfx
*.pem
*.crt
*.csr

# Configuración de firma de release (contiene contraseñas y rutas)
/android/key.properties

# Archivos temporales de keystore (Base64, etc.)
keystore_base64.txt
*keystore*.txt
*_base64.txt

# Archivos de propiedades con credenciales
*.properties
!gradle.properties

# Variables de entorno y secretos
.env
.env.local
.env.production
secrets.json
secrets.yaml
credentials.json

# Archivos de Google Services (si usas Firebase)
google-services.json
GoogleService-Info.plist

# Archivos de distribución para Play Store
*.aab
*.apk
*.apks
*.xapk

# Backups del keystore (seguridad adicional)
*keystore*.bak
*keystore*.backup
*keystore*.old

# ============================================
# CI/CD y GitHub Actions
# ============================================

# Artefactos de builds locales
/build/
/outputs/
*.hprof

# Archivos temporales de workflows
.github/tmp/
.github/cache/

# Logs de builds
*.log
build_log.txt

# ============================================
# Archivos específicos del proyecto QuickNote
# ============================================

# Archivos de versión local (si contienen datos sensibles)
VERSION.local.txt

# Backups de bases de datos locales
*.db
*.db.backup
*.sqlite
*.sqlite3

# Archivos de caché de Supabase (local)
.supabase/